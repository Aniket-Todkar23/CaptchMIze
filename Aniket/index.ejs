<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="logo">CAPTCHA Solutions</div>
        <ul class="nav-links">
            <li><a href="/">HOME</a></li>
            <li><a href="/try">TRY OUR CAPTCHAS</a></li>
            <li><a href="/developers">DEVELOPERS</a></li>
            <li><a href="/contact">CONTACT US</a></li>
        </ul>
    </nav>

    <!-- Main Section -->
    <section class="main-container">
        <!-- Left Container -->
        <div class="text-container">
            <h1>Revolutionizing CAPTCHA Systems</h1>
            <p>Experience the most innovative and adaptive CAPTCHA solutions, including GIF CAPTCHA, to enhance user verification and security like never before!</p>
        </div>

        <!-- Right Container -->
        <div class="slider-container">
            <div class="slides">
                <img src="image1.jpg" alt="Captcha Example 1" class="slide">
                <img src="image2.jpg" alt="Captcha Example 2" class="slide">
                <img src="image3.jpg" alt="Captcha Example 3" class="slide">
            </div>
            <div class="slider-buttons">
                <button class="slider-button" id="prev">&#10094;</button>
                <button class="slider-button" id="next">&#10095;</button>
            </div>
        </div>
    </section>

    <script src="/slider.js"></script>
</body>
</html>