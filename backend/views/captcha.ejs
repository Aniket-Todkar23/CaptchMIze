<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enhanced Clickable CAPTCHA</title>
    <!-- Include Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
        }
        #captcha-container {
            background: linear-gradient(to bottom right, #f0f4ff, #ffffff);
            border: 2px solid #6a11cb;
            border-radius: 10px;
        }
        #question {
            font-family: 'Poppins', sans-serif;
            font-size: 1.2rem;
            font-weight: 600;
            color: #333;
            font-display:swap;
        }
    </style>
</head>
<body class="flex justify-center items-center min-h-screen bg-gray-200 p-4 font-sans">
    <div class="flex flex-col items-center max-w-lg w-full">
        <!-- Question outside CAPTCHA -->
        <div class="mb-4 text-center" id="question"></div>

        <!-- CAPTCHA Canvas Container -->
        <div id="captcha-container" class="p-1 mb-4 shadow-lg">
            <canvas id="captcha" class="w-full rounded-md" style="max-width: 500px; height: auto;" width="500" height="200"></canvas>
        </div>

        <!-- Message area -->
        <div id="message" class="text-lg font-semibold text-center mb-2"></div>

        <!-- Timer Display -->
        <div id="timer" class="text-sm text-gray-700 font-semibold"></div>
    </div>

    <script>
        const canvas = document.getElementById("captcha");
        const ctx = canvas.getContext("2d");
        const message = document.getElementById("message");
        const question = document.getElementById("question");
        const timer = document.getElementById("timer");

        const objects = [
            { type: "circle", color: "red" },
            { type: "circle", color: "blue" },
            { type: "circle", color: "green" },
            { type: "circle", color: "yellow" },
            { type: "square", color: "orange" },
            { type: "square", color: "purple" },
            { type: "triangle", color: "pink" },
            { type: "triangle", color: "brown" },
            { type: "rectangle", color: "lime" },
            { type: "rectangle", color: "gray" },
        ];

        let target, positions, countdownInterval;

        function drawCaptcha() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            message.textContent = "";
            timer.textContent = "";

            target = objects[Math.floor(Math.random() * objects.length)];
            question.textContent = `Click on the ${target.color} ${target.type}`;

            positions = [];
            objects.forEach((obj) => {
                let x, y, overlaps;
                do {
                    x = Math.random() * (canvas.width - 70);
                    y = Math.random() * (canvas.height - 70);
                    overlaps = positions.some(
                        (pos) =>
                            Math.sqrt((pos.x - x) ** 2 + (pos.y - y) ** 2) < 80
                    );
                } while (overlaps);

                const size = Math.random() * 30 + 30;
                positions.push({ ...obj, x, y, size });

                ctx.save();
                ctx.translate(x + size / 2, y + size / 2);
                ctx.fillStyle = obj.color;
                ctx.strokeStyle = "black";
                ctx.lineWidth = 2;

                if (obj.type === "circle") {
                    ctx.beginPath();
                    ctx.arc(0, 0, size / 2, 0, 2 * Math.PI);
                    ctx.fill();
                    ctx.stroke();
                } else if (obj.type === "square") {
                    ctx.fillRect(-size / 2, -size / 2, size, size);
                    ctx.strokeRect(-size / 2, -size / 2, size, size);
                } else if (obj.type === "triangle") {
                    ctx.beginPath();
                    ctx.moveTo(0, -size / 2);
                    ctx.lineTo(-size / 2, size / 2);
                    ctx.lineTo(size / 2, size / 2);
                    ctx.closePath();
                    ctx.fill();
                    ctx.stroke();
                } else if (obj.type === "rectangle") {
                    const rectWidth = size * 1.5;
                    const rectHeight = size;
                    ctx.fillRect(-rectWidth / 2, -rectHeight / 2, rectWidth, rectHeight);
                    ctx.strokeRect(-rectWidth / 2, -rectHeight / 2, rectWidth, rectHeight);
                }
                ctx.restore();
            });

            startTimer();
        }

        canvas.addEventListener("click", (e) => {
            const rect = canvas.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            const clickedObject = positions.find(
                (pos) =>
                    x >= pos.x &&
                    x <= pos.x + pos.size &&
                    y >= pos.y &&
                    y <= pos.y + pos.size
            );

            if (clickedObject && clickedObject.color === target.color && clickedObject.type === target.type) {
                message.textContent = "You are a human!";
                message.style.color = "green";
            } else {
                message.textContent = "You might be a bot. Try again!";
                message.style.color = "red";
            }

            clearInterval(countdownInterval);
            setTimeout(drawCaptcha, 1000);
        });

        function startTimer() {
            let timeLeft = 10;
            timer.textContent = `Refreshing in: ${timeLeft}s`;

            countdownInterval = setInterval(() => {
                timeLeft--;
                timer.textContent = `Refreshing in: ${timeLeft}s`;

                if (timeLeft <= 0) {
                    clearInterval(countdownInterval);
                    drawCaptcha();
                }
            }, 1000);
        }

        drawCaptcha();
    </script>
</body>
</html>
