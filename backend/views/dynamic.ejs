<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GIF CAPTCHA</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Poppins', sans-serif;
            background: #f3f4f6;
        }
    </style>
</head>
<body class="flex justify-center items-center min-h-screen p-4">
    <div id="captcha-container" class="w-[300px] bg-white border border-gray-300 rounded-lg shadow-lg p-4">
        <h1 class="text-lg font-bold text-center text-gray-700 mb-4">What is shown in the GIF?</h1>
        <div class="flex justify-center mb-4">
            <img id="gif-image" src="/placeholder.svg" alt="Captcha GIF" class="w-full h-[150px] object-cover rounded border border-gray-200">
        </div>
        <div id="options-container" class="grid grid-cols-2 gap-2 mb-4"></div>
        <div id="message" class="text-center text-sm font-medium mb-4"></div>
        <button id="refresh-button" class="w-full bg-blue-500 text-white font-semibold py-2 px-4 rounded hover:bg-blue-600 transition-colors">
            Refresh CAPTCHA
        </button>
    </div>

    <script>
        const captchaContainer = document.getElementById('captcha-container');
        const gifImage = document.getElementById('gif-image');
        const optionsContainer = document.getElementById('options-container');
        const message = document.getElementById('message');
        const refreshButton = document.getElementById('refresh-button');

        let currentCaptchaData = null;

        async function loadNewCaptcha() {
            try {
                const response = await fetch('/getCaptchaData');
                currentCaptchaData = await response.json();
                
                gifImage.src = currentCaptchaData.gifUrl;
                optionsContainer.innerHTML = currentCaptchaData.options.map(option => `
                    <button class="captcha-option bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold py-2 px-4 rounded">
                        ${option}
                    </button>
                `).join('');

                message.textContent = '';
                message.className = 'text-center text-sm font-medium mb-4';
            } catch (error) {
                console.error('Error loading CAPTCHA:', error);
                message.textContent = 'Error loading CAPTCHA. Please try again.';
                message.className = 'text-center text-sm font-medium mb-4 text-red-500';
            }
        }

        function handleOptionClick(event) {
            if (event.target.classList.contains('captcha-option')) {
                const selectedOption = event.target.textContent.trim();
                if (selectedOption === currentCaptchaData.correctAnswer) {
                    message.textContent = "You are human!";
                    message.className = 'text-center text-sm font-medium mb-4 text-green-500';
                } else {
                    message.textContent = "You might be a bot!";
                    message.className = 'text-center text-sm font-medium mb-4 text-red-500';
                }
                setTimeout(loadNewCaptcha, 1500);
            }
        }

        refreshButton.addEventListener('click', loadNewCaptcha);
        optionsContainer.addEventListener('click', handleOptionClick);

        // Initial load
        loadNewCaptcha();
    </script>
</body>
</html>